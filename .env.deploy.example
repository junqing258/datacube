# SSH 目标必填。也可通过命令行环境变量 DEPLOY_SSH_TARGET 传入。
DEPLOY_SSH_TARGET=
DEPLOY_REMOTE_DIR=/opt/datacube
DATACUBE_PORT=3001

# 修改为部署专用的随机值，例如使用 openssl rand -hex 32。
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# 图表真实数据配置，格式见 apps/server/.env.example。
CHART_DATA_TOKEN=
CHART_DATA_CONNECTIONS=
CHART_DATA_SOURCES=
