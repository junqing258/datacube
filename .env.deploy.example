# SSH 目标必填。也可通过命令行环境变量 DEPLOY_SSH_TARGET 传入。
DEPLOY_SSH_TARGET=
DEPLOY_REMOTE_DIR=/opt/datacube
DATACUBE_PORT=3001

# 种子初始口令（8–128 个字符）。生产环境必填，仅首次创建用户时使用。
SEED_ADMIN_EMAIL=admin@datacube.local
SEED_MEMBER_EMAIL=member@datacube.local
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# 会话。HTTPS 部署时改为 true。
SESSION_IDLE_MINUTES=480
SESSION_MAX_DAYS=7
SESSION_COOKIE_SECURE=false

# 业务数据目录，格式见 apps/server/.env.example。凭据不要写入镜像。
CHART_DATA_CONNECTIONS=
CHART_DATA_SOURCES=
