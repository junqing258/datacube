# DataCube server environment
# Copy to .env and adjust values

# Server
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (default: local sqlite file)
DATABASE_URL="file:./dev.db"
# MySQL example:
# DATABASE_URL="mysql://root:root@localhost:3306/datacube"

# Session
SESSION_IDLE_MINUTES=480
SESSION_MAX_DAYS=7
# HTTPS 部署时设为 true
SESSION_COOKIE_SECURE=false

# 开发种子。生产环境必须显式设置两个初始口令（8–128 个字符）。
# 种子按空间、连接和数据集标识幂等导入下面的目录；密钥只留在服务端环境。
SEED_ADMIN_EMAIL=admin@datacube.local
SEED_MEMBER_EMAIL=member@datacube.local
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# 业务数据目录（过渡输入，后续由平台数据库管理）。Node.js 22.16+ 的 SQLite 需要绝对 file URL。
# 先运行 pnpm business:sample 生成示例业务库，再改为实际业务库。
# CHART_DATA_CONNECTIONS='{"local":"file:///absolute/path/apps/server/prisma/sample-business.db"}'
# timeField 可省略。启用 JS 数据集绑定的日期窗口时必须指定。
# CHART_DATA_SOURCES='{"sales_daily":{"name":"销售日汇总","connection":"local","table":"sales_daily","fields":["day","order_count","paid_amount","refund_amount","net_amount"],"timeField":"day"},"channel_sales_daily":{"name":"渠道销售日汇总","connection":"local","table":"channel_sales_daily","fields":["day","channel","order_count","paid_amount","refund_amount","net_amount"],"timeField":"day"}}'
# PostgreSQL / MySQL 使用业务库只读账号。secretRef 指向下面的连接标识。
# CHART_DATA_CONNECTIONS='{"erp":"postgresql://reader:password@db.example:5432/business?sslmode=verify-full","shop":"mysql://reader:password@db.example:3306/shop"}'
