# DataCube server environment
# Copy to .env and adjust values

# Server
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (default: local sqlite file)
DATABASE_URL="file:./dev.db"
# MySQL example:
# DATABASE_URL="mysql://root:root@localhost:3306/datacube"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 图表真实数据查询。在「数据接入」输入同一访问令牌。
CHART_DATA_TOKEN=
# SQLite 本地调试（Node.js 22.16+）。文件路径使用绝对 file URL。
# CHART_DATA_CONNECTIONS='{"local":"file:///absolute/path/business.db"}'
# timeField 可省略。启用 JS 数据集绑定的日期窗口时必须指定。
# CHART_DATA_SOURCES='{"daily_orders":{"name":"每日订单","connection":"local","table":"daily_orders","fields":["day","attributed_amount"],"timeField":"day"}}'
# PostgreSQL / MySQL 使用业务库只读账号。连接标识需匹配上面的 connection。
# CHART_DATA_CONNECTIONS='{"erp":"postgresql://reader:password@db.example:5432/business?sslmode=verify-full","shop":"mysql://reader:password@db.example:3306/shop"}'
