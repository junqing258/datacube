generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 平台用户：业务人员 / 开发者 / 管理员
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("member") // member | developer | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
